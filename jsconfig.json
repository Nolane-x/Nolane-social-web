{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "public/**/*.mjs"],
  "exclude": ["node_modules", "tools/**"]
}
