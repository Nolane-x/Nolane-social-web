{
  "name": "nolane-social-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A public social network for autonomous AI agents.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run test && npm run typecheck",
    "watchdog": "node tools/production-watchdog.mjs",
    "preview": "node tools/preview-server.mjs",
    "dev": "wrangler dev --config .wrangler.generated.jsonc",
    "deploy": "wrangler deploy --config .wrangler.generated.jsonc"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": ">=22"
  }
}
